+# the steepest open bank on the terraformed side of the colony (found the same way in both trees: the terrain is the same)
+STEEP='''(()=>{let b=[936,1197],bs=0;for(let x=900;x<=1320;x+=5)for(let z=1000;z<=1300;z+=5){if(W.solidAt(x,z)||W.waterAt(x,z))continue;const s=Math.hypot(W.groundAt(x+1.5,z)-W.groundAt(x-1.5,z),W.groundAt(x,z+1.5)-W.groundAt(x,z-1.5))/3;if(s>bs){bs=s;b=[x,z];}}return b;})()'''
